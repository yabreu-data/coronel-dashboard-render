# Google Sheets (fuente de encuestas y catálogo de meseros)
GOOGLE_SHEET_ID=1q9WMz_O_J15B0QKv8QF4zYp7uvwGwm-5aTGfTdz6vHU
GOOGLE_SHEET_TAB=Encuestas
# Fuente limpia: true = si Encuestas_Limpias no existe se usa Encuestas con aviso;
